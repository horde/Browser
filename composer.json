{
    "name": "horde/browser",
    "description": "Browser detection library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Browser",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "developer"
        }
    ],
    "keywords": [
        "capability_detection",
        "file_upload"
    ],
    "time": "2026-06-26",
    "repositories": [],
    "require": {
        "php": "^8",
        "horde/http": "* || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/translation": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Browser": "lib/"
        },
        "psr-4": {
            "Horde\\Browser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Browser\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}